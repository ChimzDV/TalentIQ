# TalentIQ Staffing — Flask Backend Environment Variables
# =========================================================
# Copy this file to '.env' in the backend/ folder on your server
# and fill in the real values before starting the Flask app.
#
# IMPORTANT: Never commit the real .env file to version control.

# A long, random secret string used to sign Flask session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Admin login credentials.
# These are only used the FIRST TIME the app starts and the admins table is empty.
# After the first run, changing these values here has NO effect — update via the DB directly.
ADMIN_USERNAME=admin@talentiq.com
ADMIN_PASSWORD=TalentIQ2026!

# Allowed CORS origin (the domain your HTML frontend is served from).
# Set to your exact domain with NO trailing slash.
# Example: https://talentiqstaffing.com
# If Flask and the frontend are on the same domain, this setting is not critical,
# but it is good practice to restrict it anyway.
ALLOWED_ORIGIN=https://talentiqstaffing.com
